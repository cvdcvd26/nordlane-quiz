# --- PostgreSQL (Neon). On Vercel: Storage → Neon → Connect fills this in. ---
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- File storage (Vercel Blob, private store). On Vercel: Storage → Blob → Connect. ---
BLOB_READ_WRITE_TOKEN=

# --- Delayed jobs (Upstash QStash). On Vercel: Integrations → Upstash QStash, or from console.upstash.com/qstash ---
QSTASH_TOKEN=
QSTASH_URL=https://qstash.upstash.io
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public URL QStash calls back. On Vercel it defaults to the production domain; set it for local tests (e.g. an ngrok URL).
APP_URL=

# --- Admin ---
# Random string, 32+ characters: e.g. `openssl rand -base64 48`
ADMIN_SESSION_SECRET=
# First-run bootstrap: the first login with exactly these credentials creates the admin.
# Remove ADMIN_PASSWORD after the first login and change the password in /admin/settings.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Protects the daily backup job /api/jobs/sweep (Vercel sends it automatically as a Bearer token).
CRON_SECRET=

# Optional limits
NEXT_PUBLIC_MAX_FILE_MB=4
NEXT_PUBLIC_MAX_FILES=6
