# Node.js 22.12+ (recommended: 24 LTS). Copy to .env.local and fill real values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nordlane
# For Neon migrations, use the direct connection URL (without -pooler).
DATABASE_URL_UNPOOLED=
# Optional: postgres or neon. Auto-detected for *.neon.tech.
DATABASE_DRIVER=

# Generate each secret separately with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_EMAIL=admin@example.com
# Bootstrap only. Use 10+ characters, at most 72 UTF-8 bytes; remove after first login.
ADMIN_PASSWORD=
CRON_SECRET=

# Exact public base URL. Required on a VPS or Render when QStash is used.
# Vercel Queues does not use this URL. Leave empty unless using legacy QStash.
APP_URL=
# Private Vercel Blob store. Required on Vercel for uploaded files.
BLOB_READ_WRITE_TOKEN=
# Alternative for a non-Vercel server: persistent absolute directory, e.g. /var/data/uploads.
UPLOAD_DIR=

# Optional legacy queue for non-Vercel hosts. Vercel uses its managed queue automatically.
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

NEXT_PUBLIC_MAX_FILE_MB=4
NEXT_PUBLIC_MAX_FILES=6

# Optional private admin chat translator. Keep disabled until the account has
# funded API credits and the project key has been saved securely on the server.
OPENAI_API_KEY=
OPENAI_TRANSLATION_ENABLED=false
# Local monthly ceiling (actual usage + conservative reservations), not a top-up.
# Only the fixed GPT-6 Luna model is used; allowed ceiling: >0 and <=45 USD.
OPENAI_TRANSLATION_BUDGET_USD=5
